{
	"name": "@human-tokens/site",
	"private": true,
	"type": "module",
	"description": "human-tokens.dev: posts written by people, published from Fold MD.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"cf-typegen": "wrangler types",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:seed": "bun scripts/seed.ts && wrangler d1 execute DB --local --file .seed.sql",
		"db:reset": "rm -rf .wrangler/state && bun run db:migrate && bun run db:seed",
		"db:derive": "bun scripts/derive.ts",
		"db:migrate:live": "wrangler d1 migrations apply DB --remote",
		"deploy": "vite build && wrangler deploy"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@human-tokens/renderer": "workspace:*",
		"@lezer/highlight": "1.2.5",
		"@tanstack/react-router": "1.170.27",
		"@tanstack/react-start": "1.168.44",
		"better-auth": "1.7.14",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@types/node": "^22.10.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"typescript": "6.0.3",
		"vite": "8.2.1",
		"wrangler": "4.123.0"
	}
}
